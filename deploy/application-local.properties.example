# Секреты backend на сервере.
# Скопируйте в /opt/ruk-lk/backend/application-local.properties
# и заполните значения. Файл не коммитится.

# Доступ к публикации 1С (Basic Auth)
app.onec.publication-user=
app.onec.publication-password=

# Фиксированный код для тестов. В профиле prod — ЗАПРЕЩЁН (приложение не стартанет, если задан).
app.auth.fixed-code=

# OTP (опционально)
# app.auth.otp-ttl-seconds=300
# app.auth.otp-max-attempts=5
# app.auth.send-code-cooldown-seconds=60
# app.auth.identify-rate-limit-max=10
# app.auth.identify-rate-limit-window-seconds=60

# UniSender Go — отправка кода на email
app.unisender.enabled=true
app.unisender.api-key=
app.unisender.from-email=

# MAX: если app.max.enabled=true — обязателен webhook-secret
# app.max.enabled=false
# app.max.webhook-secret=

# URL 1С — если на сервере другой адрес, чем в application.properties:
# app.onec.base-url=http://10.10.31.13/universitet_masterkova1

# МегаAPI (читательский билет).
# IP хоста API (напр. 10.10.31.190) — в AllowedClientIPs на сервере МегаAPI.
app.megaapi.enabled=true
app.megaapi.base-url=http://10.10.31.41/MegaApi
app.megaapi.token-get=
app.megaapi.token-put=
app.megaapi.dbidx=0

# Новости с new.ruc.su/blog (HTML-парсинг; по умолчанию уже включено в application.properties)
# Если из контейнера таймаут — в docker-compose extra_hosts: new.ruc.su:10.10.21.7
# app.ruc-news.enabled=true
# app.ruc-news.list-url=https://new.ruc.su/blog/
# app.ruc-news.base-url=https://new.ruc.su
# app.ruc-news.cache-ttl-seconds=900

# Админ-панель фото для пропуска (СПО / ВО). Логин/пароль задаются здесь и применяются при старте API.
app.admin.spo.username=admin-spo
app.admin.spo.password=CHANGE_ME_SPO
app.admin.he.username=admin-vo
app.admin.he.password=CHANGE_ME_HE

# Админ-панель ЛК (/admin/lk): супер-админ с доступом ко всем разделам.
app.lk-admin.username=lk-admin
app.lk-admin.password=CHANGE_ME_LK_ADMIN
app.lk-admin.full-name=Супер-администратор ЛК

# Автоотчёт отсутствующих в 21:00 МСК (по умолчанию включён в application.properties)
# app.absence-report.auto-enabled=true
# app.absence-report.auto-cron=0 0 21 * * *

# Тестовые зачётки: разделы «в разработке» без ComingSoon (через GET /api/features.previewEnabled).
# Пусто / не задано — у всех ComingSoon. Через запятую можно несколько:
# app.preview.student-ids=831857,123456

# CORS — только если фронт и API на разных origin (обычно не нужно за nginx)
# app.cors.allowed-origins=https://lk.example.com

# Киберспорт РУК: тот же секрет, что STUDENT_EXCHANGE_SECRET на стороне киберспорта
# app.esports.api-base-url=https://REPLACE_ESPORTS_API
# app.esports.frontend-url=https://REPLACE_ESPORTS_SITE
# app.esports.exchange-secret=CHANGE_ME
# app.frontend.login-url=https://my.ruc.su/login

# start.ruc.su — тот же секрет, что LK_EXCHANGE_SECRET на стороне Start
# app.start.enabled=true
# app.start.show-in-lk=false
# app.start.api-base-url=https://start.ruc.su
# app.start.frontend-url=https://start.ruc.su
# app.start.exchange-secret=CHANGE_ME
# app.start.exchange-path=/api/internal/lk/exchange
# app.start.callback-path=/account/lk/callback

# Perco-Web: автосоздание карточки, если по зачётке нет (нужны position/work-schedule id из вашей Perco)
# app.perco.enabled=true
# app.perco.base-url=
# app.perco.login=
# app.perco.password=
# app.perco.create-if-missing=true
# app.perco.division-id=13
# app.perco.access-template-id=2
# app.perco.position-id=
# app.perco.work-schedule-id=
