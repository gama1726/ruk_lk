app.onec.publication-user=
app.onec.publication-password=
app.auth.fixed-code=
app.unisender.enabled=true
app.unisender.api-key=
app.unisender.from-email=

# МегаAPI (библиотека). Не коммитьте токены.
app.megaapi.enabled=true
app.megaapi.base-url=http://10.10.31.41/MegaApi
# tokenGet — GetReader / GetHandBooks / GetDebtBooks / GetOrderBooks
app.megaapi.token-get=
# tokenPut — AddReader / UpdateReader (опционально)
app.megaapi.token-put=
app.megaapi.dbidx=0

# Админ-панель фото для пропуска (СПО / ВО). Логин/пароль применяются при старте API.
app.admin.spo.username=admin-spo
app.admin.spo.password=CHANGE_ME_SPO
app.admin.he.username=admin-vo
app.admin.he.password=CHANGE_ME_HE

# Админ-панель ЛК (/admin/lk)
app.lk-admin.username=lk-admin
app.lk-admin.password=CHANGE_ME_LK_ADMIN
app.lk-admin.full-name=Супер-администратор ЛК
